  "measurement_definitions": {
    "mismatch_measurement_0": {
      "name": "action_aligned_nonlinear_error_affinity",
      "expression": "exposure_shift_first * mean(center(tanh(E_contrast)) * center(tanh(square(B_level_energy - second_mean(A_level_energy)) - square(B_level_energy - first_mean(A_level_energy)))))",
      "measurement_meaning": "Measures whether bounded parent target-versus-complement error excess concentrates in B windows whose energy favors the A group receiving increased exposure. The affinity is positive when a window is closer to the first group's mean. Centering measures localization separately from average error contrast.",
      "limitation": "Uncomputed candidate; quartile summaries do not determine its value. Group means incompletely describe coverage, and nonlinear saturation discards magnitude. It may duplicate existing controls or contribute too little at the prescribed ridge scale. A positive value does not establish positive Y or Z.",
      "falsifying_response": "On additional independent source tasks, test the hypothesis that larger scores accompany larger Z within implementation and comparable Y. Repeated reversed associations, or no improvement over the full controls in source-task-out conditional Z prediction, would reject its proposed diagnostic value."
    },
    "mismatch_measurement_1": {
      "name": "weighted_implementation_error_affinity",
      "expression": "weighted_implementation * exposure_shift_first * mean(center(tanh(E_contrast)) * center(tanh(square(B_level_energy - second_mean(A_level_energy)) - square(B_level_energy - first_mean(A_level_energy)))))",
      "measurement_meaning": "Provides an implementation interaction with the same nonlinear parent measurement, allowing its fitted association with response to differ between uniform sampling with weights and nonuniform sampling.",
      "limitation": "This is an interaction with the first candidate, not an independent parent diagnostic. It measures no update dynamics and establishes no mechanism for S/W differences. Two tasks cannot establish a transferable implementation interaction.",
      "falsifying_response": "Across new tasks with matched S/W recipes, test whether this interaction improves prediction of the W-minus-S Z difference beyond the first measurement and all controls. Failure to reduce source-task-out error, or unstable fitted direction across tasks, would reject its added value."
    }
  },
