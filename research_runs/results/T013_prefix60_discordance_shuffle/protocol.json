{
  "protocol_id": "metropt3_selection_v1",
  "dataset_id": "metropt3_v1",
  "input_length": 32,
  "prediction_length": 8,
  "max_gap_seconds": 30,
  "window_stride": 1,
  "channels": 15,
  "model": "DLinear",
  "individual": true,
  "moving_average_kernel": 25,
  "normalization": "train_row_mean_and_population_std; zero_std_scale_1",
  "loss": "mean_squared_error_in_fixed_standardized_space",
  "primary_metric": "NMSE",
  "secondary_metric": "NMAE",
  "metric_definition": "mean over windows, all 8 horizons and all 15 channels of squared/absolute error divided by fixed train population std squared/std",
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "weight_decay": 0,
  "batch_size": 256,
  "steps": 3000,
  "validation_every": 500,
  "checkpoint_selection": "lowest_full_validation_NMSE; earlier_step_wins_ties",
  "evaluation_batch_size": 2048,
  "seed": 2026,
  "confirmation_seeds": [
    2027,
    2028
  ],
  "sampling": "per-recipe membership/loss weights/probability; paired common-uniform inverse CDF",
  "grouping": "target_start_month and high_input_variation_above_train_window_90th_percentile",
  "max_data_rounds": 3,
  "session_gpu_wall_budget_seconds": 7200,
  "test_access": "forbidden_during_development",
  "model_reference": "https://github.com/cure-lab/LTSF-Linear/blob/main/models/DLinear.py"
}
